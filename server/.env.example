# N2Flow Server Configuration Template

# Network
SQL_SERVER_PORT=8787

# Execution Controls
# Maximum parallel nodes to execute
EXECUTOR_CONCURRENCY=4
# Maximum total nodes per flow (Circuit Breaker)
MAX_FLOW_NODES=500
# Global timeout in milliseconds (5 minutes)
GLOBAL_FLOW_TIMEOUT=300000

# Secret Management (Resolver)
# Define your own secrets here. 
# Usage in Flow Editor: {{MY_API_KEY}}
# SERVER_SECRET_MY_API_KEY=sk-your-key-here

# Integration Keys (Standard Examples)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# SERPER_API_KEY=
# ELASTICSEARCH_URL=
# ELASTICSEARCH_API_KEY=
