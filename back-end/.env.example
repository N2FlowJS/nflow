# N2Flow Server Configuration Template

# Network
SQL_SERVER_PORT=8787

# Execution Controls
# Maximum parallel nodes to execute
EXECUTOR_CONCURRENCY=4
# Maximum total nodes per flow (Circuit Breaker)
MAX_FLOW_NODES=500
# Global timeout in milliseconds (5 minutes)
GLOBAL_FLOW_TIMEOUT=300000

# Secret Management (Resolver)
# Define your own secrets here. 
# Usage in Flow Editor: {{MY_API_KEY}}
# SERVER_SECRET_MY_API_KEY=sk-your-key-here

# NVIDIA NIM Configuration (Optional)
# NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com
# SERVER_SECRET_NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Integration Keys (Standard Examples)
# OPENAI_API_KEY=sk-xxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# SERPER_API_KEY=xxxxxxxx
# ELASTICSEARCH_URL=https://localhost:9200
# ELASTICSEARCH_API_KEY=xxxxxxxx

# Logging
# ENABLE_LOG_SANITIZATION=true

# Authentication
# Production always enforces authentication.
# Set ENABLE_AUTH=true in development to enforce auth locally as well.
# ENABLE_AUTH=true
# JWT_SECRET=replace-this-in-production
# VALID_API_KEYS=sk_prod_example_12345678901234567890

# Security (CORS)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
