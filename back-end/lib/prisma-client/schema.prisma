// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  output     = "../lib/prisma-client"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  username  String        @unique
  password  String // Hashed password
  name      String?
  flows     Flow[]
  secrets   UserSecret[]
  providers LLMProvider[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("users")
}

model Flow {
  id         String          @id @default(cuid())
  name       String
  data       String // Stores JSON as string (nodes and edges)
  userId     String // Owner of the flow
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions FlowExecution[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId])
  @@map("flows")
}

model FlowExecution {
  id        String    @id @default(cuid())
  flowId    String
  flow      Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  status    String    @default("idle") // idle, running, success, error
  input     String?
  output    String?
  error     String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([flowId])
  @@map("flow_executions")
}

model UserSecret {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String // Display name (e.g., "OpenAI API Key")
  key        String    @unique // The secret value (encrypted)
  label      String? // Short label/description
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("user_secrets")
}

model LLMProvider {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // User-defined name
  provider  String // e.g., "OpenAI", "Anthropic", "Ollama", "NVIDIA"
  baseUrl   String? // Custom endpoint
  apiKey    String? // Encrypted API Key
  config    String? // Optional JSON for extra settings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("llm_providers")
}
