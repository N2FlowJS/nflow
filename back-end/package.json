{
  "name": "n2flow-backend",
  "version": "0.0.0",
  "type": "module",
  "description": "N2Flow backend server with Express and LLM integration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch --import tsx index.ts",
    "build": "tsc && node scripts/postbuild.cjs",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "start": "node --enable-source-maps dist/back-end/index.js",
    "db:generate": "tsx scripts/generate-an5-client.ts",
    "db:migrate": "tsx scripts/migrate.ts apply",
    "db:migrate:status": "tsx scripts/migrate.ts status",
    "db:reset": "tsx scripts/migrate.ts reset",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@an5/adapters": "^0.2.6",
    "@an5/orm": "^1.0.9",
    "@anthropic-ai/sdk": "^0.80.0",
    "@elastic/elasticsearch": "^9.1.1",
    "@google/genai": "^1.42.0",
    "@types/node": "^22.14.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.2.0",
    "ollama": "^0.6.3",
    "openai": "^6.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@n2flow/types": "file:../packages/types",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^9.1.9",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@xyflow/react": "^12.10.2",
    "concurrently": "^9.2.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^1.0.0"
  }
}
