model UserSecret {
  id         NVARCHAR(1000) @id @default(uuid()) @description("Primary key (auto-generated UUID)")
  userId     NVARCHAR(1000)  @description("Owner of the secret")
  user       User           @relation(fields: [userId], references: [id]) @description("The user who owns this secret")
  name       NVARCHAR(255)  @description("Display name, unique per user (e.g. OpenAI API Key)")
  key        NVARCHAR(MAX)  @unique @description("The encrypted secret value")
  label      NVARCHAR(255)? @description("Short label or description")
  lastUsedAt DATETIME2?     @description("Timestamp of the last time the secret was read")
  createdAt  DATETIME2      @default(now()) @description("Timestamp when the secret was created")
  updatedAt  DATETIME2      @updatedAt @description("Timestamp of the last update")

  @@unique([userId, name])
  @@index([userId])
  @@map("user_secrets")
  @@schema("public")
  @@description("An encrypted per-user credential used by flow nodes.")
}
