# The workspace pins typescript@7 (tsgo), whose package has no JavaScript
# compiler API, while @typescript-eslint/* declares a peer range of
# ">=4.8.4 <6.1.0". Resolving that conflict needs legacy peer handling.
#
# Consequence: npm no longer auto-installs peerDependencies, so every peer a
# package expects must be declared explicitly (see @testing-library/dom and the
# @textea/json-viewer peers in front-end/package.json).
legacy-peer-deps=true

# package-lock.json is committed per workspace, so installs must not try to
# rewrite the tree shape.
package-lock=true
audit=false
fund=false