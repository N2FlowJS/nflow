DATABASE_URL="file:./dev.db"


# OpenAI API for embeddings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=text-embedding-004

# File parsing worker
MAX_PARSING_WORKERS=3
PARSING_POLLING_INTERVAL=5000

# Vector database configuration
# Options:  'local', 'nbase'
VECTOR_DB_TYPE=nbase

# Nbase Configuration
NBASE_URL=http://localhost:1307

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:1407/api/auth/oauth/callback?provider=google

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:1407/api/auth/oauth/callback?provider=github
