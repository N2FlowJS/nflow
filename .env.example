# N2Flow Unified Configuration Template

# --- BACKEND CONFIGURATION ---
# Network
SQL_SERVER_PORT=8787

# Execution Controls
EXECUTOR_CONCURRENCY=4
MAX_FLOW_NODES=500
GLOBAL_FLOW_TIMEOUT=300000

# Authentication & Security
# ENABLE_AUTH=true
JWT_SECRET=replace-this-with-a-secure-secret
ENCRYPTION_KEY=replace-with-32-byte-hex-key
# ALLOWED_ORIGINS=http://localhost:5173

# LLM & External Integrations
# OPENAI_API_KEY=sk-xxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# GOOGLE_GENAI_API_KEY=xxxxxxxx
# NVIDIA_NIM_API_KEY=nvapi-xxxxxxxx
# SERPER_API_KEY=xxxxxxxx

# Logging
# ENABLE_LOG_SANITIZATION=true

# --- FRONTEND CONFIGURATION ---
VITE_RUNTIME_URL=http://localhost:8787
VITE_API_BASE=http://localhost:8787/api
