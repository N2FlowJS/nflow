{
  "name": "n2flow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AI-powered flow editor with LLM integration",
  "author": "n2flow team",
  "scripts": {
    "install:all": "npm install && cd back-end && npm install && cd ../front-end && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd back-end && npm run dev",
    "dev:frontend": "cd front-end && npm run dev",
    "build": "concurrently \"npm run build:backend\" \"npm run build:frontend\"",
    "build:backend": "cd back-end && npm run build",
    "build:frontend": "cd front-end && npm run build",
    "preview": "cd front-end && npm run preview",
    "db:studio": "cd back-end && npm run db:studio",
    "db:migrate": "cd back-end && npm run db:migrate",
    "db:generate": "cd back-end && npm run db:generate",
    "db:push": "cd back-end && npm run db:push",
    "db:reset": "cd back-end && npm run db:reset",
    "db:seed": "cd back-end && npm run db:seed"
  },
  "devDependencies": {
    "@xyflow/react": "^12.10.2",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@prisma/client": "^7.7.0"
  }
}
